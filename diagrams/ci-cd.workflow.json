  "cards": [
    {
      "dot": "slate",
      "title": "CI · Vérifier avant de publier",
      "items": [
        "Le job tests récupère le code, prépare Python 3.12 et lance unittest.",
        "Dupont accepté ; vide, espaces et None refusés.",
        "Les deux HTML doivent exister et ne pas être vides. Leur rendu visuel n'est pas testé."
      ]
    },
    {
      "dot": "emerald",
      "title": "CD · Publier seulement après les tests",
      "items": [
        "needs: tests attend la réussite ; if réserve deploy aux pushs sur main.",
        "La fusion d'une PR déclenche un nouveau passage des tests sur main.",
        "Seul docs est publié : le programme Python n'est pas un serveur en ligne.",
        "Permissions du job : contents: read, pages: write, id-token: write."
      ]
    },
    {
      "dot": "rose",
      "title": "Échecs et protection",
      "items": [
        "Un contrôle rouge empêche le job deploy : la version publiée reste en place.",
        "La règle main exige une PR et le contrôle tests (réglage GitHub vérifié pendant le parcours).",
        "Un échec de publication se diagnostique dans le journal deploy."
      ]
    },
    {
      "dot": "cyan",
      "title": "Lire le schéma interactif",
      "items": [
        "Bleu-gris : contrôles CI. Vert / turquoise : publication CD. Rose : arrêt sur erreur.",
        "Cliquer sur un nœud révèle ses relations et ses sources.",
        "Live anime le parcours : ce n'est pas un suivi de GitHub en temps réel.",
        "Les boutons du lecteur restent partiellement en anglais."
      ]
    }
  ]
